{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "Bot": {
    "Token": "",
    "DatabasePath": "db/bot.db",
    "AnnounceOnStartup": false
  },
  "Monitor": {
    "Enabled": true,
    "IntervalMinutes": 60,
    "MaxLotAgeHours": 24,
    "MaxImages": 6,
    "MaxLotsPerRun": 30,
    "FirstRunSampleCount": 1,
    "RealEstateCodePrefixes": [ "04", "06", "70" ],
    "IncludeOtherRegions": false,
    "DefaultMaxPrice": 1000000,
    "RegionRules": [
      { "Name": "м. Київ і Київська область", "Match": [ "Київ" ], "MaxPrice": 2000000 },
      { "Name": "Львівська область", "Match": [ "Львів" ], "MaxPrice": 2000000 },
      { "Name": "Тернопільська, Івано-Франківська та Закарпатська області", "Match": [ "Тернопіл", "Франків", "Закарпат" ], "MaxPrice": 1000000 }
    ]
  }
}
