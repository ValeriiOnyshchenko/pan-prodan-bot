{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "Bot": {
    "Token": "",
    "DatabasePath": "db/bot.db",
    "AnnounceOnStartup": false
  },
  "Monitor": {
    "Enabled": true,
    "IntervalMinutes": 60,
    "MaxImages": 6,
    "MaxLotsPerRun": 30,
    "FirstRunSampleCount": 1,
    "DefaultMaxPrice": 1000000,
    "RegionRules": [
      { "Name": "Львівська область", "Match": [ "Львів" ], "MaxPrice": 2000000 },
      { "Name": "Київська область і м. Київ", "Match": [ "Київ" ], "MaxPrice": 2000000 }
    ]
  }
}
